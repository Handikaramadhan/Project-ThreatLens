POSTGRES_DB=threatlens
POSTGRES_USER=threatlens
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql+psycopg://threatlens:change-this-password@threatlens-postgres:5432/threatlens
REDIS_URL=redis://threatlens-redis:6379/0
API_CORS_ORIGINS=http://localhost:8080,http://homeserver:8080

# Optional collector credentials and controls.
NVD_API_KEY=
URLHAUS_AUTH_KEY=
COLLECTOR_WINDOW_DAYS=2
NEWS_RETENTION_DAYS=180
IOC_RETENTION_DAYS=180
COLLECTION_RUN_RETENTION_DAYS=30
COLLECTION_RUN_MIN_KEEP=10
# Development only. Production starts with an empty intelligence database.
SEED_DEMO_DATA=false

# Authentication. Enable secure cookies after Caddy is configured for HTTPS.
AUTH_COOKIE_NAME=threatlens_session
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=12

# Alerts. Telegram bot token dan Discord webhook disimpan per user dari UI.
ALERT_SECRET_KEY=generate-a-long-random-secret

# PicoClaw is an agent runtime and still requires a configured model provider.
AI_ENABLED=false
AI_PROVIDER=
AI_MODEL=
PICOCLAW_RUNNER_TOKEN=generate-a-long-random-token
PICOCLAW_RUN_TIMEOUT=180
PICOCLAW_TIMEOUT_SECONDS=180
AI_MAX_PROMPT_CHARS=12000
